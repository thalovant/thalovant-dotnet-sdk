<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Thalovant</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Thalovant.Sdk</PackageId>
    <!-- The single source of truth for the SDK version. ThalovantSdkVersion
         reads it back off the built assembly, so every user agent derives from
         this one line; nothing else in the repository names the version. -->
    <Version>0.1.4</Version>
    <Authors>Thalovant</Authors>
    <Company>Thalovant</Company>
    <Description>.NET SDK for connecting enterprise .NET and Unity apps to Thalovant hubs: control-plane API client plus the HiveMind WSS data plane with AES-128-GCM encrypted frames.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/thalovant/thalovant-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thalovant/thalovant-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>thalovant;hivemind;voice;assistant;websocket;unity</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Zero external runtime dependencies on net8.0; netstandard2.1 (Unity)
       needs the System.Text.Json package, the one allowed reference. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thalovant.Sdk.Tests" />
  </ItemGroup>

</Project>
